{
  "name": "simbolo-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "start:prod": "npm run start:prod --workspace backend",
    "deploy:migrate": "npm run prisma:deploy --workspace backend",
    "prisma:deploy": "npm run prisma:deploy --workspace backend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:validate": "npm run prisma:validate --workspace backend",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
