# Application Environment
NODE_ENV="development"
API_PORT=3001
API_PREFIX="api"
API_VERSION="v1"
FRONTEND_URLS="http://localhost:3000,http://localhost:3002,http://localhost:3003"

# Database Configuration (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postvishad@localhost:5432/simbolo?schema=public"
DATABASE_POOL_SIZE=20

# Authentication & Security
JWT_SECRET="your-jwt-secret-key-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-key-here"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# Cloud Storage Configuration (AWS S3 / Cloudflare R2)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="your-bucket-name"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
STORAGE_CDN_URL="https://cdn.yourdomain.com"

# Email Configuration (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@yourdomain.com"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379/0"
